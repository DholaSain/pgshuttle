# Copy to .env and fill in SRC_DB_URL:
#
#   ./pgshuttle init
#
# .env is gitignored -- it holds a production password. Everything else here has
# a working default, so SRC_DB_URL is usually the only line you need to change.

# -------------------------------------------------------------------- source
# The database you are copying FROM. Read-only as far as this tool is concerned:
# it runs catalog queries and COPY ... TO STDOUT, and writes nothing.
#
# Percent-encode special characters in the password:
#   @ -> %40    # -> %23    : -> %3A    / -> %2F    ? -> %3F    % -> %25
# ORM-style extras (?schema=..., ?connection_limit=..., ?pgbouncer=true) are
# stripped automatically -- libpq rejects them. TLS, TCP keepalives and timeouts
# are added for you.
SRC_DB_URL=postgresql://USER:PASSWORD@db.example.com:5432/your_db

# ------------------------------------------------------------ local target DB
# The disposable copy you get back, as a container. Any Postgres you already run
# on 5432 is untouched. Name TARGET_DB after the source so URLs line up.
TARGET_USER=postgres
TARGET_PASSWORD=postgres
TARGET_DB=appdb
TARGET_PORT=5433

# Uncomment to restore into a Postgres you already run, instead of the container.
# That path needs listen_addresses='*' and a pg_hba.conf rule for the Docker
# bridge -- which is the setup friction the container exists to avoid.
# TGT_DB_URL=postgresql://postgres:localpass@host.docker.internal:5432/appdb

# ------------------------------------------------------------------- versions
# PG_MAJOR must be >= the source server's major version -- `preflight` tells you
# if it is not. Change it, then re-run `./pgshuttle prepare`.
PG_MAJOR=16
PG_IMAGE=postgres:16
# If the source needs PostGIS or another bundled extension, swap the target
# image. Restore runs offline, so pulling it at that point is fine:
#   PG_IMAGE=postgis/postgis:16-3.4

# ------------------------------------------------------------------- tuning
# Concurrent connections to the source. Drop to 1 if runs keep dying on a weak
# link; raise it on a fast one.
JOBS_DUMP=2
# Restore is local, so it can use more.
JOBS_RESTORE=4
# pg_dump compression. Affects disk only -- compression happens client-side, so
# it does not reduce what crosses the network.
ZLEVEL=3
# asc = smallest tables first, so more tables finish before a flaky link drops.
DUMP_ORDER=asc
# 1 = count(*) every table on the source instead of trusting pg_class.reltuples.
# Slower, but makes `verify` definitive rather than approximate.
EXACT_COUNTS=0

# ------------------------------------------------- more than one database?
# PROJECT namespaces the container, the Docker volume and the compose project,
# so two databases can be set up side by side without colliding. Give the second
# one its own PROJECT, TARGET_PORT, and directories, then drive it with:
#
#   PGSHUTTLE_ENV=.env.staging ./pgshuttle dump
#
# PROJECT=pgshuttle
# BACKUPS_DIR=backups
# EXPORTS_DIR=exports
