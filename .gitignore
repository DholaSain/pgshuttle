# ---------------------------------------------------------------- credentials
# .env holds a production database password. Never commit it.
# The pattern keeps .env, .env.staging, .env.local and friends out, while still
# tracking the checked-in template.
.env
.env.*
!.env.example

# ------------------------------------------------------------ production data
# Dumped tables, restored copies and shareable archives. These hold real
# customer data and are routinely gigabytes in size.
backups/
backups-*/
exports/
exports-*/

# Loose archives anywhere in the tree, including partial writes from an
# interrupted dump or export.
*.part
*.dump
*.dump.sha256
*.sql
*.sql.gz
*.tar
*.tar.gz

# --------------------------------------------------------------------- noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
